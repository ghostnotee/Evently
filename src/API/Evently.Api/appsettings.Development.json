{
  "ConnectionStrings": {
    "evently-db": "Host=localhost;Port=5432;Database=evently-db;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": [
        "https://localhost:18080/realms/evently"
      ]
    },
    "MetadataAddress": "https://localhost:18080/realms/evently/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "https://localhost:9000/health/"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Evently.Modules.Attendance.Infrastructure.Outbox": "Warning",
        "Evently.Modules.Attendance.Infrastructure.Inbox": "Warning",
        "Evently.Modules.Events.Infrastructure.Outbox": "Warning",
        "Evently.Modules.Events.Infrastructure.Inbox": "Warning",
        "Evently.Modules.Ticketing.Infrastructure.Outbox": "Warning",
        "Evently.Modules.Ticketing.Infrastructure.Inbox": "Warning",
        "Evently.Modules.Users.Infrastructure.Outbox": "Warning",
        "Evently.Modules.Users.Infrastructure.Inbox": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Evently.Api"
    }
  }
}