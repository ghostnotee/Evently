{
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": [
        "https://localhost:18080/realms/evently"
      ]
    },
    "MetadataAddress": "https://localhost:18080/realms/evently/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "https://localhost:9000/health/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "evently-api-route": {
        "ClusterId": "evently-api-cluster",
        "Match": {
          "Path": "{**catch-all}",
          "Methods": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS",
            "HEAD"
          ]
        }
      }
    },
    "Clusters": {
      "evently-api-cluster": {
        "Destinations": {
          "evently-api": {
            "Address": "https://evently-api"
          }
        }
      }
    }
  }
}
