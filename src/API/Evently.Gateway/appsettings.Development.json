{
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": [
        "https://localhost:18080/realms/evently"
      ]
    },
    "MetadataAddress": "https://localhost:18080/realms/evently/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "https://localhost:9000/health/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "evently-api-route": {
        "ClusterId": "evently-api-cluster",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "evently-api-route2": {
        "ClusterId": "evently-api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "users/register"
        }
      }
    },
    "Clusters": {
      "evently-api-cluster": {
        "Destinations": {
          "evently-api": {
            "Address": "https://evently-api"
          }
        }
      }
    }
  }
}
